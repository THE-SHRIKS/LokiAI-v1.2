{
  "name": "lokiai-main",
  "private": true,
  "version": "1.2.0",
  "description": "LokiAI Main v1.2 — root workspace (FND-002). See AGENTS.md and Docs/ before changing anything here.",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.19.0 <25.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "dev": "pnpm -r --if-present run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "clean": "pnpm -r --if-present run clean",
    "cargo:build": "node tools/scripts/cargo-verify-guard.mjs build --workspace",
    "cargo:test": "node tools/scripts/cargo-verify-guard.mjs test --workspace",
    "cargo:fmt:check": "node tools/scripts/cargo-verify-guard.mjs fmt --all -- --check",
    "cargo:clippy": "node tools/scripts/cargo-verify-guard.mjs clippy --workspace --all-targets -- -D warnings",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run cargo:fmt:check && pnpm run cargo:build && pnpm run cargo:test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
