{
  "name": "@lokiai/ipc-client",
  "private": true,
  "version": "0.1.0",
  "description": "LokiAI Main v1.2 Node named-pipe RPC client for loki-ipc's business RPC protocol (P1-NODE-IPC-CLIENT-001) — wire-compatible with crates/loki-ipc/src/client.rs. Library only; no Electron/MCP wiring.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "engines": {
    "node": ">=24.19.0 <25.0.0"
  },
  "scripts": {
    "pretest": "node ../native-credential-store/scripts/build.ts test-support && node scripts/build-harness.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lokiai/contracts": "workspace:*",
    "@lokiai/native-credential-store": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
