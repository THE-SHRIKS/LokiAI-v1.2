# LokiAI Main v1.2 — pnpm/npm configuration (FND-002).
engine-strict=true
auto-install-peers=false
strict-peer-dependencies=false
save-exact=true

# DSK-001 KNOWN GAP, not silently worked around — see Docs/graph/handoffs/
# DSK-001-1.md section 7a for the full account. `pnpm run electron:package`
# (which internally runs `electron-forge package` through pnpm's own script
# runner) fails Forge's own preflight check, which refuses to package against
# pnpm's default "isolated" node_modules layout. Setting `node-linker=hoisted`
# here — the standard documented fix for this exact Electron+pnpm friction —
# was tried and does NOT take effect on this repo's pinned pnpm 11.21.0 (a
# fresh `rm -rf node_modules && pnpm install` still produces an isolated
# layout; root cause not conclusively identified, possibly a config-key
# rename in this pnpm major version). Real, verified evidence that the app
# itself works exists via a different path — `npx electron-forge package`
# (which resolves through plain npm instead of pnpm and doesn't hit the
# preflight check at all) produced a working `lokiai.exe` that was actually
# launched, showed the real UI, proved its single-instance lock, and quit
# cleanly. The packaged-executable *code* is proven; the *pnpm-native
# packaging command* is not yet reproducible. Whoever next touches packaging
# (a `DSK-001-R1` revision or `PKG-001`) should resolve this properly rather
# than reach for `npx` as a standing workaround.
